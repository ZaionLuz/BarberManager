<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #171717;">

    <Label
            text="BARBERMANAGER"
            style="-fx-font-size: 36px;
               -fx-font-weight: bold;
               -fx-text-fill: #D4A54C;" />

    <Label
            text="Sistema de Gerenciamento de Barbearia"
            style="-fx-font-size: 17px;
               -fx-text-fill: white;" />

    <Button
            text="Começar"
            style="-fx-background-color: #D4A54C;
               -fx-text-fill: #171717;
               -fx-font-size: 15px;
               -fx-font-weight: bold;
               -fx-padding: 12 32;" />

</VBox>
