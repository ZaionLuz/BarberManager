<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.barbermanager.controller.ClienteController"
      spacing="18">

    <!-- CABEÇALHO + CARD DE RESUMO -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Gerenciamento de Clientes"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F5F5F5;"/>
            <Label text="Cadastre, consulte e gerencie a base de clientes da barbearia."
                   style="-fx-font-size: 13px; -fx-text-fill: #969696;"/>
        </VBox>

        <VBox alignment="CENTER_RIGHT" spacing="2"
              style="-fx-background-color: #181818;
                     -fx-border-color: #2B2B2B;
                     -fx-border-radius: 8;
                     -fx-background-radius: 8;
                     -fx-padding: 10 18;">
            <Label text="TOTAL CADASTRADO"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #8A8A8A;"/>
            <Label fx:id="lblTotalClientes" text="0 clientes"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #D4A54C;"/>
        </VBox>
    </HBox>

    <!-- CARD DO FORMULÁRIO -->
    <VBox spacing="14"
          style="-fx-background-color: #181818;
                 -fx-padding: 20;
                 -fx-background-radius: 10;
                 -fx-border-color: #2A2A2A;
                 -fx-border-radius: 10;">

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region prefWidth="3" prefHeight="16" style="-fx-background-color: #D4A54C;"/>
            <Label text="Novo Cadastro / Edição"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #EAEAEA;"/>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Nome Completo" style="-fx-text-fill: #BDBDBD; -fx-font-size: 12px;"/>
                <TextField fx:id="txtNome" promptText="Ex: João Silva"
                           style="-fx-background-color: #212121;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #666666;
                                  -fx-border-color: #323232;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-padding: 10;"/>
            </VBox>

            <VBox spacing="6" prefWidth="250">
                <Label text="Telefone / WhatsApp" style="-fx-text-fill: #BDBDBD; -fx-font-size: 12px;"/>
                <TextField fx:id="txtTelefone" promptText="Ex: 88999999999"
                           style="-fx-background-color: #212121;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #666666;
                                  -fx-border-color: #323232;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-padding: 10;"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Limpar Campos" onAction="#limparCampos"
                    style="-fx-background-color: #262626;
                           -fx-text-fill: #D4D4D4;
                           -fx-border-color: #363636;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-padding: 9 18;
                           -fx-cursor: hand;"/>
            <Button text="Salvar Cliente" onAction="#salvarCliente"
                    style="-fx-background-color: #D4A54C;
                           -fx-text-fill: #141414;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 9 24;
                           -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- CARD DA LISTAGEM -->
    <VBox spacing="12" VBox.vgrow="ALWAYS"
          style="-fx-background-color: #181818;
                 -fx-padding: 20;
                 -fx-background-radius: 10;
                 -fx-border-color: #2A2A2A;
                 -fx-border-radius: 10;">

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Clientes Cadastrados"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #EAEAEA;"/>

            <TextField fx:id="txtBusca" promptText="Pesquisar por nome ou telefone..." HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #212121;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #666666;
                              -fx-border-color: #323232;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-padding: 8 12;"/>

            <Button text="Atualizar" onAction="#carregarClientes"
                    style="-fx-background-color: #262626;
                           -fx-text-fill: #D4A54C;
                           -fx-border-color: #383838;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-padding: 8 16;
                           -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="tabelaClientes" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="ID" minWidth="70" maxWidth="90"/>
                <TableColumn fx:id="colNome" text="Nome Completo"/>
                <TableColumn fx:id="colTelefone" text="Telefone / WhatsApp"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Editar Selecionado" onAction="#prepararEdicao"
                    style="-fx-background-color: #262626;
                           -fx-text-fill: #EAEAEA;
                           -fx-border-color: #363636;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-padding: 8 16;
                           -fx-cursor: hand;"/>
            <Button text="Excluir Selecionado" onAction="#excluirSelecionado"
                    style="-fx-background-color: #4A1C1C;
                           -fx-text-fill: #FF9E9E;
                           -fx-border-color: #6E2929;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-padding: 8 16;
                           -fx-cursor: hand;"/>
        </HBox>
    </VBox>

</VBox>