<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.barbermanager.controller.DashboardController"
            style="-fx-background-color: #121212;">

    <!-- BARRA LATERAL -->
    <left>
        <VBox spacing="10" prefWidth="240"
              style="-fx-background-color: #171717;
                     -fx-border-color: #262626;
                     -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="28" right="18" bottom="22" left="18"/>
            </padding>

            <!-- MARCA -->
            <VBox spacing="4">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region prefWidth="4" prefHeight="22"
                            style="-fx-background-color: #D4A54C; -fx-background-radius: 2;"/>
                    <Label text="BARBERMANAGER"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #F5F5F5;"/>
                </HBox>
                <Label text="Painel Administrativo"
                       style="-fx-font-size: 12px; -fx-text-fill: #7E7E7E; -fx-padding: 0 0 0 12;"/>
            </VBox>

            <Region prefHeight="1" style="-fx-background-color: #262626;">
                <VBox.margin>
                    <Insets top="10" bottom="10"/>
                </VBox.margin>
            </Region>

            <Label text="NAVEGAÇÃO"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6E6E6E; -fx-padding: 0 0 4 8;"/>

            <Button text="Clientes" maxWidth="Infinity" onAction="#abrirClientes"
                    style="-fx-background-color: #252118;
                           -fx-text-fill: #D4A54C;
                           -fx-font-weight: bold;
                           -fx-border-color: #D4A54C;
                           -fx-border-width: 0 0 0 3;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 11 14;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;
                           -fx-font-size: 14px;"/>

            <Button text="Barbeiros" maxWidth="Infinity" onAction="#avisoEmBreve"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #9E9E9E;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 11 14;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;
                           -fx-font-size: 14px;"/>

            <Button text="Serviços" maxWidth="Infinity" onAction="#avisoEmBreve"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #9E9E9E;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 11 14;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;
                           -fx-font-size: 14px;"/>

            <Button text="Agendamentos" maxWidth="Infinity" onAction="#avisoEmBreve"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #9E9E9E;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 11 14;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;
                           -fx-font-size: 14px;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- RODAPÉ DA SIDEBAR -->
            <VBox spacing="2"
                  style="-fx-background-color: #1D1D1D; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #292929; -fx-border-radius: 8;">
                <Label text="Banco Conectado"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #D4A54C;"/>
                <Label text="MySQL · barbermanager"
                       style="-fx-font-size: 11px; -fx-text-fill: #8A8A8A;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTEÚDO CENTRAL -->
    <center>
        <StackPane fx:id="conteudoCentral" style="-fx-background-color: #121212;">
            <padding>
                <Insets top="26" right="30" bottom="26" left="30"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>